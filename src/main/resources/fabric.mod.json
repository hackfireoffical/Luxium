{
  "schemaVersion": 1,
  "id": "aetherlux",
  "version": "${version}",
  "name": "Aetherlux",
  "description": "High-performance visual mod: stunning night skies, galaxies, comets, god rays and soft low-res shadows. Aimed at stable 60 FPS on weak devices.",
  "authors": [
    "H1ckF1re"
  ],
  "contact": {
    "homepage": "https://github.com/hackfireoffical/Luxium",
    "sources": "https://github.com/hackfireoffical/Luxium"
  },
  "license": "MIT",
  "icon": "assets/aetherlux/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.hackfire.aetherlux.AetherluxClient"
    ]
  },
  "mixins": [
    "aetherlux.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
